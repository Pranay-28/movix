{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-src *; frame-ancestors *;"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "ALLOWALL"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/tmdb/:path*",
            "destination": "https://api.tmdb.org/3/:path*"
        },
        {
            "source": "/api/image/:path*",
            "destination": "https://image.tmdb.org/t/p/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}